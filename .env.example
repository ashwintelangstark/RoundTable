# Required for AI reasoning across all 5 interview agents
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-lightning:free

# Local Kokoro neural voice quantization (fp32 | fp16 | q8 | q4)
KOKORO_DTYPE=q8

# Authentication session signing secret (recommended for production Vercel deploys)
# AUTH_SECRET=generate_a_long_random_hex_string

# Static Welcome Email delivery on user sign-up (choose Gmail SMTP OR Resend API)
# Option A: Gmail SMTP (create a 16-character App Password in your Google Account Security settings)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.account@gmail.com
# SMTP_PASS=your_16_char_gmail_app_password
# SMTP_FROM="RoundTable <your.account@gmail.com>"

# Option B: Resend HTTP API (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxxx
# MAIL_FROM="RoundTable <welcome@yourdomain.com>"

# Optional persistent cloud storage for interview video clips on Vercel
# BLOB_READ_WRITE_TOKEN=
