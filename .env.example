# Required for AI reasoning across all 5 interview agents
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODEL=openrouter/free

# Local Kokoro neural voice quantization (fp32 | fp16 | q8 | q4)
KOKORO_DTYPE=q8

# Authentication session signing secret (recommended for production Vercel deploys)
# AUTH_SECRET=generate_a_long_random_hex_string

# Optional persistent cloud storage for interview video clips on Vercel
# BLOB_READ_WRITE_TOKEN=
