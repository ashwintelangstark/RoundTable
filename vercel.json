{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "node_modules/kokoro-js/voices/{am_puck,af_heart,bm_daniel,af_sarah,bm_george}.bin",
      "excludeFiles": "node_modules/{onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64},onnxruntime-web,@napi-rs,@huggingface/transformers/{.cache,dist/{*.wasm,*.map,*web*}},pdfjs-dist/{web,cmaps,standard_fonts}}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/recordings/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|recordings/|assets/|favicon|logo|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
