{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 3008,
      "excludeFiles": "node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32,linux/arm64}/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/recordings/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|recordings/|assets/|favicon|logo|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
